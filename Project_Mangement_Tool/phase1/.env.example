# Copy this file to .env and fill in your keys.

# Anthropic (Claude) — used by all chat-based agents
ANTHROPIC_API_KEY=your_anthropic_api_key

# Default Claude model for the agents (override per-agent if needed)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings provider — needed ONLY by RoutingAgent and RAGKnowledgePromptAgent.
# Anthropic has no embeddings API, so use OpenAI here (or swap for Voyage later).
OPENAI_API_KEY=your_openai_api_key
